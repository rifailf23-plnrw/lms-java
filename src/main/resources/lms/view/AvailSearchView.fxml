<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lms.controller.AvailSearchController"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <VBox style="-fx-background-color: #3a3a5c; -fx-padding: 12;">
            <Label text="Book Availability Search"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="Search by title. Use * at the end as a wildcard (e.g. 'Harry*')."
                   style="-fx-text-fill: #ccccdd; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 16;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Search Title:" style="-fx-font-size: 13px;"/>
                <TextField fx:id="searchField" prefWidth="300"
                           promptText="e.g. Harry* or 1984"/>
                <Button text="Search" onAction="#onSearch"
                        style="-fx-background-color: #4f86c6; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <Button text="Export Results" onAction="#onExport"
                        style="-fx-font-size: 13px;"/>
            </HBox>

            <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px;"/>

            <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colBookId"    text="Book ID"    prefWidth="90"/>
                    <TableColumn fx:id="colTitle"     text="Title"      prefWidth="200"/>
                    <TableColumn fx:id="colAuthor"    text="Author"     prefWidth="160"/>
                    <TableColumn fx:id="colCopies"    text="Copies"     prefWidth="70"/>
                    <TableColumn fx:id="colAvail"     text="Available"  prefWidth="90"/>
                    <TableColumn fx:id="colIsbn"      text="ISBN-13"    prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
