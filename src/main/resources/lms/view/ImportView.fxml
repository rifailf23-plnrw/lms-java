<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lms.controller.ImportController"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <VBox style="-fx-background-color: #3a3a5c; -fx-padding: 12;">
            <Label text="Java Library Viewer — Import Data Files"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="Load book.csv, student.csv and transactions.csv from your Python project folder."
                   style="-fx-text-fill: #ccccdd; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <!-- ── Centre: main content ── -->
    <center>
        <VBox spacing="12" style="-fx-padding: 16;">

            <!-- File picker row -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="folderPathField"
                           promptText="Select folder containing CSV files..."
                           prefWidth="580" editable="false"
                           style="-fx-font-size: 13px;"/>
                <Button text="Browse Folder..." onAction="#onBrowseFolder"
                        style="-fx-font-size: 13px;"/>
                <Button text="Import Files" onAction="#onImport"
                        style="-fx-background-color: #4f86c6; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Status label -->
            <Label fx:id="statusLabel" text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #336633;"/>

            <!-- Tabs: Books | Students | Transactions | Errors -->
            <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">

                <!-- Books tab -->
                <Tab text="Books" closable="false">
                    <TableView fx:id="booksTable" prefHeight="380">
                        <columns>
                            <TableColumn fx:id="colBookId"    text="Book ID"      prefWidth="80"/>
                            <TableColumn fx:id="colTitle"     text="Title"        prefWidth="160"/>
                            <TableColumn fx:id="colIsbn"      text="ISBN-13"      prefWidth="130"/>
                            <TableColumn fx:id="colAuthor"    text="Author"       prefWidth="140"/>
                            <TableColumn fx:id="colCopies"    text="Copies"       prefWidth="60"/>
                            <TableColumn fx:id="colAvail"     text="Available"    prefWidth="75"/>
                            <TableColumn fx:id="colPrice"     text="Price (£)"    prefWidth="80"/>
                        </columns>
                    </TableView>
                </Tab>

                <!-- Students tab -->
                <Tab text="Students" closable="false">
                    <TableView fx:id="studentsTable" prefHeight="380">
                        <columns>
                            <TableColumn fx:id="colStudentId"   text="Student ID"   prefWidth="120"/>
                            <TableColumn fx:id="colFirstName"   text="First Name"   prefWidth="200"/>
                        </columns>
                    </TableView>
                </Tab>

                <!-- Transactions tab -->
                <Tab text="Transactions" closable="false">
                    <TableView fx:id="transactionsTable" prefHeight="380">
                        <columns>
                            <TableColumn fx:id="colDate"      text="Date"         prefWidth="100"/>
                            <TableColumn fx:id="colTxBookId"  text="Book ID"      prefWidth="80"/>
                            <TableColumn fx:id="colTxStudId"  text="Student ID"   prefWidth="100"/>
                            <TableColumn fx:id="colType"      text="Type"         prefWidth="80"/>
                        </columns>
                    </TableView>
                </Tab>

                <!-- Errors tab -->
                <Tab text="⚠ Errors" closable="false">
                    <VBox spacing="8" style="-fx-padding: 8;">
                        <Label text="Invalid rows detected during import. Edit the raw CSV line below and click Save to correct it."
                               style="-fx-text-fill: #993300; -fx-font-size: 12px;"/>
                        <TableView fx:id="errorsTable" prefHeight="260"
                                   onMouseClicked="#onErrorSelected">
                            <columns>
                                <TableColumn fx:id="colErrFile"   text="File"     prefWidth="120"/>
                                <TableColumn fx:id="colErrLine"   text="Line"     prefWidth="50"/>
                                <TableColumn fx:id="colErrReason" text="Reason"   prefWidth="250"/>
                                <TableColumn fx:id="colErrRaw"    text="Raw Data" prefWidth="350"/>
                            </columns>
                        </TableView>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Edit selected row:" style="-fx-font-size: 12px;"/>
                            <TextField fx:id="editField" prefWidth="500"
                                       promptText="Select a row above to edit it here..."/>
                            <Button text="Save Correction" onAction="#onSaveCorrection"
                                    style="-fx-background-color: #e07020; -fx-text-fill: white;"/>
                        </HBox>
                    </VBox>
                </Tab>

            </TabPane>
        </VBox>
    </center>

    <!-- ── Bottom: navigation ── -->
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #eeeeee;"
              alignment="CENTER_RIGHT">
            <Button text="Books Issued Report →"    onAction="#onGoIssuedReport"
                    style="-fx-font-size: 13px;"/>
            <Button text="Average Book Cost →"      onAction="#onGoAvgCost"
                    style="-fx-font-size: 13px;"/>
            <Button text="Book Availability Search →" onAction="#onGoAvailSearch"
                    style="-fx-font-size: 13px;"/>
        </HBox>
    </bottom>

</BorderPane>
