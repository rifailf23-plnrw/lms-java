<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lms.controller.IssuedReportController"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <VBox style="-fx-background-color: #3a3a5c; -fx-padding: 12;">
            <Label text="Books Issued Report"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="View all books issued on a specific date."
                   style="-fx-text-fill: #ccccdd; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 16;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Enter Date (DD/MM/YYYY):" style="-fx-font-size: 13px;"/>
                <TextField fx:id="dateField" prefWidth="140"
                           promptText="e.g. 16/04/2026"/>
                <Button text="Search" onAction="#onSearch"
                        style="-fx-background-color: #4f86c6; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px;"/>

            <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colBookId"    text="Book ID"    prefWidth="90"/>
                    <TableColumn fx:id="colTitle"     text="Title"      prefWidth="180"/>
                    <TableColumn fx:id="colAuthor"    text="Author"     prefWidth="150"/>
                    <TableColumn fx:id="colStudentId" text="Student ID" prefWidth="110"/>
                    <TableColumn fx:id="colName"      text="Name"       prefWidth="120"/>
                    <TableColumn fx:id="colDate"      text="Date"       prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
